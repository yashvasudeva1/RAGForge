"""
RAGForge environment variable template.

Copy this file to `.env` and fill in the values for the providers you want to use.
You do not need to fill in all keys — only the ones relevant to your pipeline.
"""

# ============================================================
# Application
# ============================================================
APP_NAME=RAGForge
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ============================================================
# API Server
# ============================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_PREFIX=/api

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# LLM Provider API Keys
# (only fill in the providers you plan to use)
# ============================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Google Generative AI / Vertex AI
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=

# Groq
GROQ_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Cohere
COHERE_API_KEY=

# VoyageAI (embeddings + reranking)
VOYAGE_API_KEY=

# HuggingFace Hub
HUGGINGFACE_API_KEY=

# ============================================================
# Embedding Defaults
# ============================================================
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSIONS=1536

# ============================================================
# Chunking Defaults
# ============================================================
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_CHUNKER=recursive

# ============================================================
# Vector Store
# ============================================================
DEFAULT_VECTORSTORE=chroma

# ChromaDB (default — works locally with no external service)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ragforge

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENVIRONMENT=

# Weaviate
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Milvus / Zilliz
MILVUS_URI=
MILVUS_TOKEN=

# LanceDB (local columnar store)
LANCEDB_URI=./data/lancedb

# ============================================================
# Retrieval Defaults
# ============================================================
DEFAULT_RETRIEVAL_K=5
DEFAULT_RETRIEVAL_STRATEGY=dense

# ============================================================
# Reranking Defaults
# ============================================================
DEFAULT_RERANKER=
DEFAULT_RERANK_TOP_N=3

# ============================================================
# Generation Defaults
# ============================================================
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=1024

# ============================================================
# Ollama (local open-source LLMs)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# Pipeline Execution
# ============================================================
MAX_CONCURRENT_PIPELINES=5
PIPELINE_TIMEOUT_SECONDS=300
PIPELINE_STORAGE_DIR=./data/pipelines

# ============================================================
# Observability (optional)
# ============================================================
ENABLE_TRACING=false
OTEL_EXPORTER_ENDPOINT=
